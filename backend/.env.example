ENVIRONMENT=development
DEBUG=true

# Upstage Solar API 키 (선택, 비워두면 로컬 무비용 모드)
# 발급: https://console.upstage.ai/
UPSTAGE_API_KEY=
LLM_MODEL=solar-pro3
ENABLE_SOLAR=false
ENABLE_SOLAR_DETECTION=false
SOLAR_MAX_TOKENS=350
ENABLE_OCR=false
SESSION_TTL_MINUTES=120
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase 설정
SUPABASE_URL=
# 신규 백엔드 전용 키(sb_secret_...). 절대로 NEXT_PUBLIC_*로 노출하지 마세요.
SUPABASE_SECRET_KEY=
# 신규 브라우저용 키. 현재 ScamFlow 프론트는 DB에 직접 연결하지 않아 비워둬도 됩니다.
SUPABASE_PUBLISHABLE_KEY=
# Legacy service_role JWT 호환용
SUPABASE_SERVICE_ROLE_KEY=
# 이전 프로젝트 설정 호환용. secret/service_role 키를 자동 판별합니다.
SUPABASE_KEY=
ENABLE_SUPABASE=false

# URL 평판 조회. 각 provider 실패는 중립 점수로 처리됩니다.
ENABLE_URL_REPUTATION=false
GOOGLE_SAFE_BROWSING_API_KEY=
KISA_WHOIS_API_KEY=
KISA_WHOIS_API_URL=https://apis.data.go.kr/B551505/whois
# 기존 분석 기록만 조회하며 URL을 새로 제출하지 않습니다.
VIRUSTOTAL_API_KEY=
EXTERNAL_API_TIMEOUT_SECONDS=8

# Scenario RAG ON/OFF 비교. Response Policy RAG와 공식 대응정보 RAG는 계속 사용합니다.
# false: Scenario RAG 유사 사례 검색만 생략
# true: Scenario RAG 유사 사례 검색 보강
RAG_ENABLED=false
RAG_AUTO_BUILD_INDEX=true
RAG_SCENARIO_TOP_K=5
RAG_SCENARIO_MIN_SIMILARITY=0.16
